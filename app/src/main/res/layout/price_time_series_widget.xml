<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:id="@+id/time_series_widget_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_background_neutral">

        <LinearLayout
            android:id="@+id/time_series_content_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="4dp"
            android:paddingBottom="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="bottom">

                <TextView
                    android:id="@+id/time_series_title_text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textStyle="bold"
                    android:textSize="19sp"
                    android:text="@string/time_series_widget_title" />

                <!-- Fixed-size slot holding either the tappable refresh
                     icon or, while a refresh is in flight, a small
                     spinner in its place, mirroring the KDE widget's
                     ToolButton/BusyIndicator pair in the same spot. Only
                     one of the two is visible at a time (see
                     WidgetUpdateUtil.buildTimeSeriesWidgetViews). -->
                <FrameLayout
                    android:id="@+id/time_series_refresh_slot"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="4dp"
                    android:clipChildren="false">

                    <TextView
                        android:id="@+id/time_series_refresh_icon"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="bottom|center_horizontal"
                        android:includeFontPadding="false"
                        android:translationY="4dp"
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="26.25sp"
                        android:text="\u27F3"
                        android:contentDescription="@string/time_series_widget_refresh_content_description" />

                    <ProgressBar
                        android:id="@+id/time_series_refresh_spinner"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom|center_horizontal"
                        android:translationY="4dp"
                        android:indeterminate="true"
                        android:indeterminateTint="?android:attr/textColorSecondary"
                        android:visibility="gone"
                        style="?android:attr/progressBarStyleSmall" />

                </FrameLayout>

                <TextView
                    android:id="@+id/time_series_price_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textStyle="bold"
                    android:textSize="20sp"
                    android:text="@string/price_unavailable" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="4dp">

                <TextView
                    android:id="@+id/time_series_link_text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="middle"
                    android:maxLines="1"
                    android:textColor="?android:attr/textColorLink"
                    android:textSize="10sp"
                    android:text="@string/time_series_widget_link_label" />

                <TextView
                    android:id="@+id/time_series_last_updated_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="9sp"
                    android:text="@string/time_placeholder" />

            </LinearLayout>

            <!-- Chart row: a fixed-width Y-axis label column (real
                 TextViews, immune to any bitmap-scaling error) beside the
                 chart image itself, which now contains only gridlines and
                 the plotted data, no text. This column's width (20dp) and
                 the chart image's marginStart (2dp) are both baked into
                 CHART_HORIZONTAL_CHROME_DP in WidgetUpdateUtil, which
                 subtracts them (along with this container's own
                 start/end padding) when estimating how much width is
                 actually left for the chart bitmap.

                 Labels are right-aligned (gravity="end"), flush against
                 the chart's edge, so the cent symbol - and the decimal
                 point on sub-cent labels - sits at the same fixed x for
                 every label, with any extra digits (a 2-digit "40¢" vs.
                 a 1-digit "6¢") or a leading minus sign (ComEd prices go
                 negative occasionally) growing leftward into the
                 column's own space instead of shifting the symbol
                 itself. Left-aligning instead would fix each label's
                 *first* character in place rather than its last, which
                 is what actually needs to line up for the column to read
                 as a column of numbers at a glance. 20dp comfortably
                 fits the widest realistic label ("-14¢" or a sub-cent
                 "-1.5¢"); anything longer would only come from a
                 pathological price and can clip without breaking the
                 common case. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/time_series_y_axis_labels"
                    android:layout_width="20dp"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="end">

                    <TextView
                        android:id="@+id/time_series_y_label_top"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="9sp" />

                    <TextView
                        android:layout_width="1dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/time_series_y_label_upper_mid"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="9sp" />

                    <TextView
                        android:layout_width="1dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/time_series_y_label_lower_mid"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="9sp" />

                    <TextView
                        android:layout_width="1dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/time_series_y_label_bottom"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="9sp" />

                </LinearLayout>

                <ImageView
                    android:id="@+id/time_series_chart_image"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="2dp"
                    android:scaleType="fitXY"
                    android:contentDescription="@string/time_series_widget_chart_content_description" />

            </LinearLayout>

            <!-- X-axis label row: a leading spacer matching the Y-axis
                 column's width (so the three time labels line up under
                 the chart, not under the whole widget), then start/mid/end
                 labels evenly spread across the chart's width. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="20dp"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/time_series_x_label_start"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="2dp"
                    android:gravity="start"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="9sp" />

                <TextView
                    android:id="@+id/time_series_x_label_mid"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="9sp" />

                <TextView
                    android:id="@+id/time_series_x_label_end"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="9sp" />

            </LinearLayout>

        </LinearLayout>

    </FrameLayout>

</FrameLayout>
